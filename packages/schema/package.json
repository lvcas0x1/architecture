{
  "name": "@architecture/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema types and placement rules shared by the editor and the viewer",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./json-schema/*": "./generated/*"
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
