{
  "$defs": {
    "ArrowStyle": {
      "enum": [
        "none",
        "start",
        "end",
        "both"
      ],
      "title": "ArrowStyle",
      "type": "string"
    },
    "BadgeTone": {
      "enum": [
        "ok",
        "warn",
        "error",
        "muted"
      ],
      "title": "BadgeTone",
      "type": "string"
    },
    "BorderSide": {
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "title": "BorderSide",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "accountId": {
          "default": "",
          "type": "string"
        },
        "region": {
          "default": "",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "error",
            "unsupported"
          ],
          "type": "string"
        },
        "message": {
          "default": "",
          "type": "string"
        },
        "count": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "source",
        "profile",
        "accountId",
        "region",
        "status",
        "message",
        "count"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "description": "Root of ``workspace/diagrams/*.arch.json``.",
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/DiagramMeta"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "layout": {
          "$ref": "#/$defs/LayoutOptions"
        },
        "nodes": {
          "items": {
            "discriminator": {
              "mapping": {
                "group": "#/$defs/GroupNode",
                "resource": "#/$defs/ResourceNode",
                "shape": "#/$defs/ShapeNode",
                "text": "#/$defs/TextNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ResourceNode"
              },
              {
                "$ref": "#/$defs/GroupNode"
              },
              {
                "$ref": "#/$defs/TextNode"
              },
              {
                "$ref": "#/$defs/ShapeNode"
              }
            ]
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "viewport",
        "layout",
        "nodes",
        "edges"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "DiagramMeta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "Untitled architecture",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generator": {
          "default": "user",
          "enum": [
            "user",
            "ai",
            "mixed"
          ],
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "updatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accountIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "description",
        "generator",
        "createdAt",
        "updatedAt",
        "accountIds",
        "regions"
      ],
      "title": "DiagramMeta",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "sourceHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targetHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data": {
          "$ref": "#/$defs/EdgeData"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "sourceHandle",
        "targetHandle",
        "data"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeData": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "$ref": "#/$defs/LineStyle",
          "default": "solid"
        },
        "arrow": {
          "$ref": "#/$defs/ArrowStyle",
          "default": "end"
        },
        "router": {
          "$ref": "#/$defs/EdgeRouter",
          "default": "smoothstep"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "default": 1.5,
          "exclusiveMinimum": 0,
          "maximum": 12,
          "type": "number"
        },
        "relationType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "user"
        }
      },
      "required": [
        "line",
        "arrow",
        "router",
        "label",
        "color",
        "width",
        "relationType",
        "origin"
      ],
      "title": "EdgeData",
      "type": "object"
    },
    "EdgeRouter": {
      "enum": [
        "straight",
        "smoothstep",
        "step",
        "bezier"
      ],
      "title": "EdgeRouter",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "config",
            "resource-explorer",
            "describe",
            "human",
            "inferred"
          ],
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "observedAt",
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GraphRelation": {
      "additionalProperties": false,
      "properties": {
        "sourceArn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "targetArn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "category": {
          "enum": [
            "containment",
            "association",
            "permission",
            "traffic",
            "inferred"
          ],
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        }
      },
      "required": [
        "sourceArn",
        "targetArn",
        "type",
        "category",
        "evidence"
      ],
      "title": "GraphRelation",
      "type": "object"
    },
    "GraphResource": {
      "additionalProperties": false,
      "properties": {
        "arn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "iconKey": {
          "default": "Resource/General-Icons/Generic-Application",
          "type": "string"
        },
        "availabilityZones": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vpcIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subnetIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "type": "object"
        },
        "subnetVisibility": {
          "default": "unknown",
          "enum": [
            "public",
            "private",
            "unknown"
          ],
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedResource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "arn",
        "accountId",
        "region",
        "resourceType",
        "resourceId",
        "name",
        "iconKey",
        "availabilityZones",
        "vpcIds",
        "subnetIds",
        "tags",
        "parameters",
        "subnetVisibility",
        "evidence",
        "detail"
      ],
      "title": "GraphResource",
      "type": "object"
    },
    "GroupNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Size"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parentId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zIndex": {
          "default": 0,
          "type": "integer"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "group",
          "default": "group",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/GroupNodeData"
        }
      },
      "required": [
        "id",
        "position",
        "size",
        "parentId",
        "zIndex",
        "locked",
        "hidden",
        "type",
        "data"
      ],
      "title": "GroupNode",
      "type": "object"
    },
    "GroupNodeData": {
      "additionalProperties": false,
      "description": "A box (VPC / AZ / subnet / any frame).",
      "properties": {
        "label": {
          "default": "",
          "type": "string"
        },
        "labelColor": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fillColor": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fillOpacity": {
          "anyOf": [
            {
              "maximum": 0.9,
              "minimum": 0.1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "$ref": "#/$defs/GroupStyle",
          "default": "generic"
        },
        "resourceRef": {
          "anyOf": [
            {
              "description": "Resource ARN (the key a diagram references)",
              "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "iconKey": {
          "anyOf": [
            {
              "examples": [
                "Architecture/Compute/Amazon-EC2"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collapsed": {
          "default": false,
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "user"
        }
      },
      "required": [
        "label",
        "labelColor",
        "fillColor",
        "fillOpacity",
        "style",
        "resourceRef",
        "iconKey",
        "collapsed",
        "origin"
      ],
      "title": "GroupNodeData",
      "type": "object"
    },
    "GroupStyle": {
      "description": "Box presets. Border colour, corner label and pale fill follow the AWS diagram conventions.",
      "enum": [
        "global",
        "on-premises",
        "account",
        "region",
        "vpc",
        "az",
        "subnet-public",
        "subnet-private",
        "security-group",
        "auto-scaling-group",
        "generic"
      ],
      "title": "GroupStyle",
      "type": "string"
    },
    "HumanAuthority": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/Diagram"
        },
        "protected": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "deletedNodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deletedEdges": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deletedRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deletedConnections": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "baseline",
        "protected",
        "deletedNodes",
        "deletedEdges",
        "deletedRefs",
        "deletedConnections"
      ],
      "title": "HumanAuthority",
      "type": "object"
    },
    "LayoutMode": {
      "enum": [
        "manual",
        "auto"
      ],
      "title": "LayoutMode",
      "type": "string"
    },
    "LayoutOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/LayoutMode",
          "default": "manual"
        },
        "algorithm": {
          "default": "layered",
          "enum": [
            "layered",
            "mrtree",
            "force",
            "rectpacking"
          ],
          "type": "string"
        },
        "direction": {
          "default": "RIGHT",
          "enum": [
            "RIGHT",
            "DOWN",
            "LEFT",
            "UP"
          ],
          "type": "string"
        },
        "nodeSpacing": {
          "default": 48,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "layerSpacing": {
          "default": 96,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "padding": {
          "default": 32,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "mode",
        "algorithm",
        "direction",
        "nodeSpacing",
        "layerSpacing",
        "padding"
      ],
      "title": "LayoutOptions",
      "type": "object"
    },
    "Lifecycle": {
      "description": "Whether the resource still exists. Updated by ``Refresh``.",
      "enum": [
        "active",
        "deleted",
        "error",
        "unknown"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "LineStyle": {
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ],
      "title": "LineStyle",
      "type": "string"
    },
    "NormalizedResource": {
      "additionalProperties": false,
      "description": "One normalized resource (``workspace/inventory/resources/*.json``).",
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "type": "string"
        },
        "arn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "accountId": {
          "pattern": "^[0-9]{12}$",
          "type": "string"
        },
        "accountAlias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "minLength": 1,
          "type": "string"
        },
        "resourceType": {
          "pattern": "^AWS::[A-Za-z0-9]+::[A-Za-z0-9]+$",
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "type": "array"
        },
        "iconKey": {
          "examples": [
            "Architecture/Compute/Amazon-EC2"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "default": "unknown"
        },
        "fetchedAt": {
          "format": "date-time",
          "type": "string"
        },
        "deletedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "type": "array"
        },
        "raw": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "arn",
        "accountId",
        "accountAlias",
        "region",
        "resourceType",
        "resourceId",
        "service",
        "name",
        "tags",
        "iconKey",
        "lifecycle",
        "fetchedAt",
        "deletedAt",
        "lastError",
        "sections",
        "relations",
        "raw"
      ],
      "title": "NormalizedResource",
      "type": "object"
    },
    "Origin": {
      "description": "Element authorship.",
      "enum": [
        "ai",
        "user"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "description": "A relationship to another resource. The material an AI uses to draw edges.",
      "properties": {
        "type": {
          "pattern": "^[a-z][a-z0-9\\-]*$",
          "type": "string"
        },
        "targetArn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "targetArn",
        "label"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ResourceGraph": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "architecture-inventory",
          "default": "architecture-inventory",
          "type": "string"
        },
        "version": {
