{
  "$defs": {
    "InventoryEntry": {
      "additionalProperties": false,
      "description": "One entry in ``workspace/inventory/index.json``.",
      "properties": {
        "arn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "accountAlias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "type": "array"
        },
        "iconKey": {
          "examples": [
            "Architecture/Compute/Amazon-EC2"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "default": "unknown"
        },
        "fetchedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hasDetail": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "arn",
        "accountId",
        "accountAlias",
        "region",
        "resourceType",
        "resourceId",
        "service",
        "name",
        "tags",
        "iconKey",
        "lifecycle",
        "fetchedAt",
        "hasDetail"
      ],
      "title": "InventoryEntry",
      "type": "object"
    },
    "Lifecycle": {
      "description": "Whether the resource still exists. Updated by ``Refresh``.",
      "enum": [
        "active",
        "deleted",
        "error",
        "unknown"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "Tag": {
      "additionalProperties": false,
      "description": "An AWS resource tag.",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Tag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole inventory index file.",
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "enum": [
        "resource-explorer",
        "config-aggregator",
        "describe",
        "mixed"
      ],
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "entries"
  ],
  "title": "Inventory",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.local/schema/inventory.schema.json"
}
