{
  "$defs": {
    "ArrowStyle": {
      "enum": [
        "none",
        "start",
        "end",
        "both"
      ],
      "title": "ArrowStyle",
      "type": "string"
    },
    "BadgeTone": {
      "enum": [
        "ok",
        "warn",
        "error",
        "muted"
      ],
      "title": "BadgeTone",
      "type": "string"
    },
    "BorderSide": {
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "title": "BorderSide",
      "type": "string"
    },
    "Diagram": {
      "additionalProperties": false,
      "description": "Root of ``workspace/diagrams/*.arch.json``.",
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/DiagramMeta"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "layout": {
          "$ref": "#/$defs/LayoutOptions"
        },
        "nodes": {
          "items": {
            "discriminator": {
              "mapping": {
                "group": "#/$defs/GroupNode",
                "resource": "#/$defs/ResourceNode",
                "shape": "#/$defs/ShapeNode",
                "text": "#/$defs/TextNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ResourceNode"
              },
              {
                "$ref": "#/$defs/GroupNode"
              },
              {
                "$ref": "#/$defs/TextNode"
              },
              {
                "$ref": "#/$defs/ShapeNode"
              }
            ]
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "meta",
        "viewport",
        "layout",
        "nodes",
        "edges"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "DiagramMeta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "Untitled architecture",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generator": {
          "default": "user",
          "enum": [
            "user",
            "ai",
            "mixed"
          ],
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "updatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accountIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "description",
        "generator",
        "createdAt",
        "updatedAt",
        "accountIds",
        "regions"
      ],
      "title": "DiagramMeta",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "sourceHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targetHandle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data": {
          "$ref": "#/$defs/EdgeData"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "sourceHandle",
        "targetHandle",
        "data"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeData": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "$ref": "#/$defs/LineStyle",
          "default": "solid"
        },
        "arrow": {
          "$ref": "#/$defs/ArrowStyle",
          "default": "end"
        },
        "router": {
          "$ref": "#/$defs/EdgeRouter",
          "default": "smoothstep"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "default": 1.5,
          "exclusiveMinimum": 0,
          "maximum": 12,
          "type": "number"
        },
        "relationType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "user"
        }
      },
      "required": [
        "line",
        "arrow",
        "router",
        "label",
        "color",
        "width",
        "relationType",
        "origin"
      ],
      "title": "EdgeData",
      "type": "object"
    },
    "EdgeRouter": {
      "enum": [
        "straight",
        "smoothstep",
        "step",
        "bezier"
      ],
      "title": "EdgeRouter",
      "type": "string"
    },
    "ExportOptions": {
      "additionalProperties": false,
      "properties": {
        "includeRaw": {
          "default": false,
          "type": "boolean"
        },
        "interactive": {
          "default": true,
          "type": "boolean"
        },
        "includeSearch": {
          "default": true,
          "type": "boolean"
        },
        "maskAccountIds": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "includeRaw",
        "interactive",
        "includeSearch",
        "maskAccountIds"
      ],
      "title": "ExportOptions",
      "type": "object"
    },
    "GroupNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Size"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parentId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zIndex": {
          "default": 0,
          "type": "integer"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "group",
          "default": "group",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/GroupNodeData"
        }
      },
      "required": [
        "id",
        "position",
        "size",
        "parentId",
        "zIndex",
        "locked",
        "hidden",
        "type",
        "data"
      ],
      "title": "GroupNode",
      "type": "object"
    },
    "GroupNodeData": {
      "additionalProperties": false,
      "description": "A box (VPC / AZ / subnet / any frame).",
      "properties": {
        "label": {
          "default": "",
          "type": "string"
        },
        "labelColor": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fillColor": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fillOpacity": {
          "anyOf": [
            {
              "maximum": 0.9,
              "minimum": 0.1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "$ref": "#/$defs/GroupStyle",
          "default": "generic"
        },
        "resourceRef": {
          "anyOf": [
            {
              "description": "Resource ARN (the key a diagram references)",
              "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "iconKey": {
          "anyOf": [
            {
              "examples": [
                "Architecture/Compute/Amazon-EC2"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collapsed": {
          "default": false,
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "user"
        }
      },
      "required": [
        "label",
        "labelColor",
        "fillColor",
        "fillOpacity",
        "style",
        "resourceRef",
        "iconKey",
        "collapsed",
        "origin"
      ],
      "title": "GroupNodeData",
      "type": "object"
    },
    "GroupStyle": {
      "description": "Box presets. Border colour, corner label and pale fill follow the AWS diagram conventions.",
      "enum": [
        "global",
        "on-premises",
        "account",
        "region",
        "vpc",
        "az",
        "subnet-public",
        "subnet-private",
        "security-group",
        "auto-scaling-group",
        "generic"
      ],
      "title": "GroupStyle",
      "type": "string"
    },
    "LayoutMode": {
      "enum": [
        "manual",
        "auto"
      ],
      "title": "LayoutMode",
      "type": "string"
    },
    "LayoutOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/LayoutMode",
          "default": "manual"
        },
        "algorithm": {
          "default": "layered",
          "enum": [
            "layered",
            "mrtree",
            "force",
            "rectpacking"
          ],
          "type": "string"
        },
        "direction": {
          "default": "RIGHT",
          "enum": [
            "RIGHT",
            "DOWN",
            "LEFT",
            "UP"
          ],
          "type": "string"
        },
        "nodeSpacing": {
          "default": 48,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "layerSpacing": {
          "default": 96,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "padding": {
          "default": 32,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "mode",
        "algorithm",
        "direction",
        "nodeSpacing",
        "layerSpacing",
        "padding"
      ],
      "title": "LayoutOptions",
      "type": "object"
    },
    "Lifecycle": {
      "description": "Whether the resource still exists. Updated by ``Refresh``.",
      "enum": [
        "active",
        "deleted",
        "error",
        "unknown"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "LineStyle": {
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ],
      "title": "LineStyle",
      "type": "string"
    },
    "NormalizedResource": {
      "additionalProperties": false,
      "description": "One normalized resource (``workspace/inventory/resources/*.json``).",
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "type": "string"
        },
        "arn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "accountId": {
          "pattern": "^[0-9]{12}$",
          "type": "string"
        },
        "accountAlias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "minLength": 1,
          "type": "string"
        },
        "resourceType": {
          "pattern": "^AWS::[A-Za-z0-9]+::[A-Za-z0-9]+$",
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "type": "array"
        },
        "iconKey": {
          "examples": [
            "Architecture/Compute/Amazon-EC2"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "default": "unknown"
        },
        "fetchedAt": {
          "format": "date-time",
          "type": "string"
        },
        "deletedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "type": "array"
        },
        "raw": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schemaVersion",
        "arn",
        "accountId",
        "accountAlias",
        "region",
        "resourceType",
        "resourceId",
        "service",
        "name",
        "tags",
        "iconKey",
        "lifecycle",
        "fetchedAt",
        "deletedAt",
        "lastError",
        "sections",
        "relations",
        "raw"
      ],
      "title": "NormalizedResource",
      "type": "object"
    },
    "Origin": {
      "description": "Element authorship.",
      "enum": [
        "ai",
        "user"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "description": "A relationship to another resource. The material an AI uses to draw edges.",
      "properties": {
        "type": {
          "pattern": "^[a-z][a-z0-9\\-]*$",
          "type": "string"
        },
        "targetArn": {
          "description": "Resource ARN (the key a diagram references)",
          "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "targetArn",
        "label"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ResourceMount": {
      "description": "How a resource icon sits in its container.",
      "enum": [
        "inside",
        "border"
      ],
      "title": "ResourceMount",
      "type": "string"
    },
    "ResourceNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Size"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parentId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-:.]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zIndex": {
          "default": 0,
          "type": "integer"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "resource",
          "default": "resource",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ResourceNodeData"
        }
      },
      "required": [
        "id",
        "position",
        "size",
        "parentId",
        "zIndex",
        "locked",
        "hidden",
        "type",
        "data"
      ],
      "title": "ResourceNode",
      "type": "object"
    },
    "ResourceNodeData": {
      "additionalProperties": false,
      "description": "An AWS resource icon.",
      "properties": {
        "iconKey": {
          "examples": [
            "Architecture/Compute/Amazon-EC2"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*(/[A-Za-z0-9][A-Za-z0-9\\-\\.]*)+$",
          "type": "string"
        },
        "resourceRef": {
          "anyOf": [
            {
              "description": "Resource ARN (the key a diagram references)",
              "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "labelOverride": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "showFields": {
          "items": {
            "enum": [
              "service",
              "name",
              "resourceId",
              "tags"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "maxTags": {
          "default": 3,
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "mount": {
          "$ref": "#/$defs/ResourceMount",
          "default": "inside"
        },
        "borderSide": {
          "anyOf": [
            {
              "$ref": "#/$defs/BorderSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "user"
        }
      },
      "required": [
        "iconKey",
        "resourceRef",
        "labelOverride",
        "showFields",
        "maxTags",
        "mount",
        "borderSide",
        "origin"
      ],
      "title": "ResourceNodeData",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "description": "One row in the parameter popup's table.",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/RowKind",
          "default": "text"
        },
        "tone": {
          "anyOf": [
            {
              "$ref": "#/$defs/BadgeTone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "anyOf": [
            {
              "description": "Resource ARN (the key a diagram references)",
              "pattern": "^arn:[a-z0-9\\-]*:[a-z0-9\\-]*:[a-z0-9\\-]*:[0-9]{0,12}:.+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "label",
        "value",
        "kind",
        "tone",
        "href",
        "ref"
      ],
      "title": "Row",
      "type": "object"
    },
    "RowKind": {
      "enum": [
        "text",
        "code",
        "badge",
        "link",
        "list"
      ],
      "title": "RowKind",
      "type": "string"
    },
